# ====================================================================
# Konfigurasi Environment - PT GPM Warehouse Administration Backend
# ====================================================================

PORT=5000
JWT_SECRET=supersecretkey_gudang_gpm

# --------------------------------------------------------------------
# KONFIGURASI DATABASE SUPABASE (POSTGRESQL)
# --------------------------------------------------------------------
#
# Langkah mendapatkan URL di Supabase:
# 1. Buka Dashboard Supabase -> Pilih Project -> Klik Settings (ikon gigi) -> Database.
# 2. Cari bagian "Connection String".
#
# DATABASE_URL: Gunakan mode "Transaction" (Connection Pooling) - Port 6543 dengan pgbouncer=true.
# DIRECT_URL: Gunakan mode "Session" (Direct Connection) - Port 5432 untuk keperluan migrasi/db push.
#
# Gantilah [password], [project-ref-id], dan [db-name] (biasanya postgres) dengan kredensial Anda.

DATABASE_URL="postgres://postgres.[project-ref-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/[db-name]?pgbouncer=true"
DIRECT_URL="postgres://postgres.[project-ref-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/[db-name]"
